# Swift Package Manager build artifacts
pipeline/.build/
App/.build/

# Whisper models -- large, publicly downloadable, not project-specific
pipeline/models/

# Pipeline working cache (temp audio/wav during transcription, cleaned up after each episode)
pipeline/cache/

# The app bundles a copy of the corpus for local dev -- pipeline/corpus/rmc.sqlite is the
# single source of truth; this is just a build-time `cp`, not a separate copy to track.
App/RetroMacCast/Resources/rmc.sqlite

# The corpus DB itself is ~100MB and changes every pipeline run -- tracking it in git would
# bloat history by that much on every commit. It's published as a GitHub Release asset by the
# weekly-sync workflow instead; this repo only ever tracks the code that builds it.
pipeline/corpus/rmc.sqlite
pipeline/corpus/manifest.json

# macOS
.DS_Store

# Xcode per-user state (window layout, breakpoints, recently opened files) -- machine-
# specific, regenerated automatically, and just noise in a diff for anyone else who opens
# this project. Shared schemes (xcshareddata/) are NOT covered by this and stay tracked.
xcuserdata/
*.xcuserstate
